# URL of the running backend the test suite will call.
BASE_URL=http://localhost:8000

# URL of the running frontend, used by UI test cases (Playwright).
FRONTEND_URL=http://localhost:5173

# "mock" (default, no API key needed) or "gemini" (needs GEMINI_API_KEY below).
LLM_PROVIDER=mock

# Only needed if LLM_PROVIDER=gemini.
# GEMINI_API_KEY=
